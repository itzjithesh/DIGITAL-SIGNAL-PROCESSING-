% ============================================
% Bandpass Filter Comparison: Butterworth vs Chebyshev Type-I
% ============================================

clc; clear; close all;

Fs = 2000;   % Sampling Frequency
Rp = 1;      % Passband Ripple (dB)
Rs = 40;     % Stopband Attenuation (dB)

Wp = [300 600] / (Fs/2);   % Passband Edge (normalized)
Ws = [200 700] / (Fs/2);   % Stopband Edge (normalized)

% Butterworth Bandpass Filter
[n1, W1] = buttord(Wp, Ws, Rp, Rs);
[b1, a1] = butter(n1, W1, 'bandpass');

% Chebyshev Type-I Bandpass Filter
[n2, W2] = cheb1ord(Wp, Ws, Rp, Rs);
[b2, a2] = cheby1(n2, Rp, W2, 'bandpass');

% Magnitude Response
figure; freqz(b1, a1); title('Butterworth Filter');
figure; freqz(b2, a2); title('Chebyshev Type-I Filter');

% Group Delay Comparison
figure;
grpdelay(b1, a1); hold on;
grpdelay(b2, a2);
legend('Butterworth', 'Chebyshev-I');

% Pole-Zero Plots
figure;
subplot(121), zplane(b1, a1), title('Butterworth');
subplot(122), zplane(b2, a2), title('Chebyshev-I');

% Impulse Responses
figure;
subplot(211), impz(b1, a1), title('Butterworth Impulse');
subplot(212), impz(b2, a2), title('Chebyshev Impulse');

% Pole Magnitude Comparison
figure;
subplot(121), stem(abs(roots(a1)), 'filled'), title('Butterworth Pole Magnitude');
subplot(122), stem(abs(roots(a2)), 'filled'), title('Chebyshev Pole Magnitude');

% Display Filter Orders
disp(['Butterworth Order = ', num2str(n1)]);
disp(['Chebyshev Order = ', num2str(n2)]);
