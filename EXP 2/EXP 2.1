% ============================================
% EX NO:2 Chebyshev Type-I IIR Low-Pass Filter
% Design and Performance Evaluation using MATLAB
% ============================================

clc; clear; close all;

Wp = 0.4;   % Normalized Passband frequency
Ws = 0.55;  % Normalized Stopband frequency
Rp = 1;     % Passband Ripple in dB
As = 40;    % Stopband Attenuation in dB

[N, Wn] = cheb1ord(Wp, Ws, Rp, As);
[b, a] = cheby1(N, Rp, Wn);

fprintf('Filter Order = %d\n', N);
fprintf('Cutoff Frequency = %.2f * pi rad/sample\n', Wn);

if all(abs(roots(a)) < 1)
    disp('System is STABLE');
else
    disp('System is UNSTABLE');
end

figure; freqz(b, a);
figure; impz(b, a);
figure; grpdelay(b, a);
figure; zplane(b, a);
